{
    admin off
    auto_https off
}
:8080 {
    root * /srv
    encode gzip zstd
    header {
        Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    respond /health "ok" 200
    file_server
}
